<mujoco model="go2 scene">
  <include file="go2.xml" />

  <statistic center="0 0 0.1" extent="0.8" />

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
    <rgba haze="0.15 0.25 0.35 1" />
    <global azimuth="-130" elevation="-20" />
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072" />
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300" />
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2" />
  <hfield name="perlin_hfield" size="1.0 0.75 0.2 0.2" file="../height_field.png" /><hfield name="image_hfield" size="1.0 1.0 0.02 0.1" file="../unitree_hfield.png" /></asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true" />

    <!-- ===================================================== -->
    <!-- Home Delivery Scene: 只修改场景地图，不修改 Go2 模型 -->
    <!-- 主题：居家递送 / 门槛 / 地毯 / 床边目标点 / 低矮障碍物 -->
    <!-- ===================================================== -->

    <!-- 基础地面：保留 name="floor"，避免其他脚本依赖地面名称 -->
    <geom name="floor"
          size="0 0 0.05"
          type="plane"
          material="groundplane"
          friction="0.90 0.01 0.001" />

    <!-- ===================== 房间边界/视觉墙体：已避开机器狗出生点 ===================== -->
    <!-- 机器狗默认出生在 (0, 0)，因此墙体不能穿过 x=0 或 y=0 的中心线 -->
    <geom name="home_wall_back"
          type="box"
          pos="5.00 0.00 0.45"
          size="0.05 1.60 0.45"
          rgba="0.82 0.82 0.78 1"
          contype="1"
          conaffinity="1" />

    <geom name="home_wall_left"
          type="box"
          pos="2.45 1.60 0.45"
          size="2.55 0.05 0.45"
          rgba="0.82 0.82 0.78 1"
          contype="1"
          conaffinity="1" />

    <geom name="home_wall_right"
          type="box"
          pos="2.45 -1.60 0.45"
          size="2.55 0.05 0.45"
          rgba="0.82 0.82 0.78 1"
          contype="1"
          conaffinity="1" />


    <!-- ===================== 房间边界/视觉墙体 ===================== -->
    <!-- 墙体位置避开机器狗初始点，主要用于截图展示居家环境 -->

    <!-- ===================== 居家递送通行区域 ===================== -->
    <!-- 卧室门槛：先设置为 2.5cm，比较温和，策略不容易直接摔 -->
    <geom name="home_door_threshold"
          type="box"
          pos="1.20 0.00 0.025"
          size="0.85 0.08 0.025"
          rgba="0.55 0.35 0.18 1"
          friction="0.95 0.02 0.001"
          contype="1"
          conaffinity="1" />

    <!-- 地毯：模拟软地面/高摩擦地形扰动 -->
    <geom name="home_carpet"
          type="box"
          pos="2.20 0.00 0.012"
          size="1.20 0.80 0.012"
          rgba="0.45 0.62 0.58 1"
          friction="1.25 0.03 0.003"
          contype="1"
          conaffinity="1" />

    <!-- 低矮拖鞋：用于截图展示，不放在正中主路线，避免未经训练直接绊倒 -->
    <geom name="home_slipper_left"
          type="box"
          pos="1.85 0.58 0.030"
          euler="0 0 0.45"
          size="0.22 0.08 0.030"
          rgba="0.85 0.65 0.35 1"
          friction="0.80 0.02 0.001"
          contype="1"
          conaffinity="1" />

    <geom name="home_slipper_right"
          type="box"
          pos="2.85 -0.52 0.030"
          euler="0 0 -0.35"
          size="0.22 0.08 0.030"
          rgba="0.85 0.65 0.35 1"
          friction="0.80 0.02 0.001"
          contype="1"
          conaffinity="1" />

    <!-- 小玩具/书本：生活化低矮障碍物 -->
    <geom name="home_toy_block"
          type="box"
          pos="3.15 0.42 0.080"
          euler="0 0 0.25"
          size="0.13 0.13 0.080"
          rgba="0.90 0.45 0.35 1"
          friction="0.75 0.02 0.001"
          contype="1"
          conaffinity="1" />

    <geom name="home_book_stack"
          type="box"
          pos="2.55 0.82 0.050"
          euler="0 0 -0.25"
          size="0.30 0.20 0.050"
          rgba="0.40 0.40 0.75 1"
          friction="0.75 0.02 0.001"
          contype="1"
          conaffinity="1" />

    <!-- ===================== 老人床边递送目标区域 ===================== -->
    <geom name="home_bed"
          type="box"
          pos="4.25 0.95 0.28"
          size="1.05 0.70 0.28"
          rgba="0.60 0.50 0.42 1"
          contype="1"
          conaffinity="1" />

    <geom name="home_pillow"
          type="box"
          pos="3.65 1.30 0.60"
          size="0.32 0.22 0.08"
          rgba="0.88 0.88 0.82 1"
          contype="1"
          conaffinity="1" />

    <geom name="home_bedside_table"
          type="box"
          pos="3.60 -0.55 0.35"
          size="0.32 0.32 0.35"
          rgba="0.50 0.42 0.35 1"
          contype="1"
          conaffinity="1" />

    <!-- 绿色递送目标点：仅作为可视化标记，不参与碰撞 -->
    <geom name="home_delivery_target"
          type="cylinder"
          pos="3.60 -0.55 0.73"
          size="0.16 0.02"
          rgba="0.20 0.80 0.25 1"
          contype="0"
          conaffinity="0" />

    <!-- 蓝色水杯标记：仅视觉展示，不参与碰撞；真正动态负载仍使用原模型里的 payload_ball -->
    <geom name="home_visual_cup"
          type="cylinder"
          pos="3.60 -0.55 0.82"
          size="0.055 0.10"
          rgba="0.25 0.55 0.95 0.55"
          contype="0"
          conaffinity="0" />

    <!-- ===================== 动态障碍物的静态占位版 ===================== -->
    <!-- 注意：这里不添加 slide joint，避免改变 qpos/qvel 排列，保护你的控制代码 -->
    <geom name="home_pet_obstacle"
          type="cylinder"
          pos="2.70 1.05 0.16"
          size="0.18 0.16"
          rgba="0.95 0.45 0.35 1"
          friction="0.60 0.02 0.001"
          contype="1"
          conaffinity="1" />

    <!-- 起点/终点可视化 site，不参与碰撞 -->
    <site name="home_start_site"
          pos="0.00 0.00 0.05"
          size="0.08"
          rgba="0.20 0.40 1.00 1" />

    <site name="home_goal_site"
          pos="3.60 -0.55 0.08"
          size="0.10"
          rgba="0.20 1.00 0.20 1" />
  </worldbody>
</mujoco>