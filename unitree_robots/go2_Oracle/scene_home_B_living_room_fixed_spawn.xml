<mujoco model="go2 scene">
  <include file="go2.xml" />

  <statistic center="0 0 0.1" extent="0.8" />

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
    <rgba haze="0.15 0.25 0.35 1" />
    <global azimuth="-130" elevation="-20" />
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072" />
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300" />
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2" />
    <hfield name="perlin_hfield" size="1.0 0.75 0.2 0.2" file="../height_field.png" />
    <hfield name="image_hfield" size="1.0 1.0 0.02 0.1" file="../unitree_hfield.png" />
  </asset>

  <worldbody>
    <light pos="0 0 2.4" dir="0 0 -1" directional="true" />
    <light pos="3.0 1.5 2.1" dir="-1 -1 -1" directional="false" diffuse="0.55 0.55 0.55" />

    <!-- ===================================================== -->
    <!-- Scene B Fixed: 客厅绕行型家居递送场景，出生点安全版      -->
    <!-- 关键约束：x < 1.20 范围内除 floor/site 外没有碰撞物体     -->
    <!-- 这样 Go2 默认在 (0,0) 出生时不会和墙体/家具/道具卡住       -->
    <!-- ===================================================== -->

    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" friction="0.90 0.01 0.001" />

    <!-- 出生安全区标记：仅 site，不参与碰撞 -->
    <site name="safe_spawn_area" pos="0.00 0.00 0.05" size="0.16" rgba="0.20 0.40 1.00 0.65" />

    <!-- 开放客厅边界：全部放到 x>=1.20 之后，避开出生点 -->
    <geom name="living_wall_left" type="box"
          pos="3.60 1.75 0.48" size="2.40 0.05 0.48"
          rgba="0.82 0.82 0.78 1" contype="1" conaffinity="1" />
    <geom name="living_wall_right" type="box"
          pos="3.60 -1.75 0.48" size="2.40 0.05 0.48"
          rgba="0.82 0.82 0.78 1" contype="1" conaffinity="1" />
    <geom name="living_wall_back" type="box"
          pos="6.00 0.00 0.48" size="0.05 1.75 0.48"
          rgba="0.82 0.82 0.78 1" contype="1" conaffinity="1" />

    <!-- 入口门框：从 x=1.25 开始，不碰出生点 -->
    <geom name="entrance_frame_left" type="box"
          pos="1.25 1.10 0.50" size="0.06 0.15 0.50"
          rgba="0.55 0.40 0.25 1" contype="1" conaffinity="1" />
    <geom name="entrance_frame_right" type="box"
          pos="1.25 -1.10 0.50" size="0.06 0.15 0.50"
          rgba="0.55 0.40 0.25 1" contype="1" conaffinity="1" />

    <!-- 第一处小门槛：放在出生点前方 1.45m，先用 2cm，稳定后可调高 -->
    <geom name="threshold_B_entry" type="box"
          pos="1.45 0.00 0.020" size="0.58 0.055 0.020"
          rgba="0.55 0.35 0.18 1" friction="0.95 0.02 0.001"
          contype="1" conaffinity="1" />

    <!-- 大地毯在客厅中心，避开出生点 -->
    <geom name="living_big_carpet" type="box"
          pos="2.85 0.10 0.012" size="1.35 0.95 0.012"
          rgba="0.58 0.42 0.62 1" friction="1.18 0.03 0.003"
          contype="1" conaffinity="1" />
    <geom name="living_carpet_roll" type="capsule"
          pos="2.10 0.98 0.026" euler="1.5708 0 1.5708"
          size="0.016 0.38" rgba="0.50 0.36 0.55 1"
          friction="1.10 0.03 0.003" contype="1" conaffinity="1" />

    <!-- 沙发和茶几构成 L 形绕行，整体后移 -->
    <geom name="sofa_long" type="box"
          pos="2.75 1.38 0.25" size="0.85 0.25 0.25"
          rgba="0.42 0.37 0.34 1" contype="1" conaffinity="1" />
    <geom name="sofa_side" type="box"
          pos="1.85 0.90 0.25" size="0.24 0.55 0.25"
          rgba="0.42 0.37 0.34 1" contype="1" conaffinity="1" />
    <geom name="coffee_table_B" type="box"
          pos="3.20 0.45 0.15" size="0.40 0.24 0.15"
          rgba="0.50 0.42 0.35 1" contype="1" conaffinity="1" />
    <geom name="small_stool" type="cylinder"
          pos="4.05 1.18 0.16" size="0.16 0.16"
          rgba="0.55 0.45 0.35 1" contype="1" conaffinity="1" />

    <!-- 电线和玩具散落：全部远离出生点 -->
    <geom name="charging_cable_B" type="capsule"
          pos="2.85 -0.82 0.016" euler="1.5708 0 -0.3"
          size="0.014 0.54" rgba="0.05 0.05 0.05 1"
          friction="0.70 0.02 0.001" contype="1" conaffinity="1" />
    <geom name="toy_B1" type="box"
          pos="1.75 -0.72 0.055" euler="0 0 0.35"
          size="0.10 0.09 0.055" rgba="0.90 0.45 0.35 1"
          friction="0.75 0.02 0.001" contype="1" conaffinity="1" />
    <geom name="toy_B2" type="box"
          pos="3.85 -0.38 0.060" euler="0 0 -0.2"
          size="0.11 0.10 0.060" rgba="0.30 0.50 0.90 1"
          friction="0.75 0.02 0.001" contype="1" conaffinity="1" />
    <geom name="book_B" type="box"
          pos="4.30 0.48 0.045" euler="0 0 0.3"
          size="0.26 0.16 0.045" rgba="0.40 0.40 0.75 1"
          friction="0.75 0.02 0.001" contype="1" conaffinity="1" />

    <!-- 客厅出口到卧室的小门槛 -->
    <geom name="threshold_B_room" type="box"
          pos="4.55 -0.25 0.022" size="0.50 0.055 0.022"
          rgba="0.55 0.35 0.18 1" friction="0.95 0.02 0.001"
          contype="1" conaffinity="1" />

    <!-- 目标区在右后方，形成绕行路径 -->
    <geom name="bed_B" type="box"
          pos="5.35 -0.98 0.28" size="0.62 0.42 0.28"
          rgba="0.60 0.50 0.42 1" contype="1" conaffinity="1" />
    <geom name="bedside_B" type="box"
          pos="4.75 -1.38 0.34" size="0.25 0.24 0.34"
          rgba="0.50 0.42 0.35 1" contype="1" conaffinity="1" />
    <geom name="target_B" type="cylinder"
          pos="4.75 -1.38 0.70" size="0.13 0.02"
          rgba="0.20 0.80 0.25 1" contype="0" conaffinity="0" />
    <geom name="cup_B" type="cylinder"
          pos="4.75 -1.38 0.80" size="0.045 0.085"
          rgba="0.25 0.55 0.95 0.55" contype="0" conaffinity="0" />

    <!-- 宠物占位：远离出生点，不加 joint -->
    <geom name="pet_B" type="cylinder"
          pos="4.25 1.18 0.15" size="0.15 0.15"
          rgba="0.95 0.45 0.35 1" friction="0.60 0.02 0.001"
          contype="1" conaffinity="1" />

    <!-- 路线标记：不参与碰撞 -->
    <site name="start_B" pos="0.00 0.00 0.05" size="0.08" rgba="0.20 0.40 1.00 1" />
    <site name="mid_B0" pos="1.45 0.00 0.05" size="0.06" rgba="1.00 0.80 0.20 1" />
    <site name="mid_B1" pos="2.55 -0.65 0.05" size="0.06" rgba="1.00 0.80 0.20 1" />
    <site name="mid_B2" pos="4.55 -0.25 0.05" size="0.06" rgba="1.00 0.80 0.20 1" />
    <site name="goal_B" pos="4.75 -1.38 0.08" size="0.10" rgba="0.20 1.00 0.20 1" />
  </worldbody>
</mujoco>
